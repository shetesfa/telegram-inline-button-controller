# Telegram Bot API Token obtained from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Comma-separated list of Telegram User IDs authorized to control the system
# Obtain your ID from @userinfobot or @raw_data_bot
ADMIN_IDS=123456789,987654321

# SQLite database file path or URL
# For relative file path: sqlite+aiosqlite:///telegram_manager.db
DATABASE_URL=sqlite+aiosqlite:///telegram_manager.db

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Application environment: development or production
APP_ENV=development
